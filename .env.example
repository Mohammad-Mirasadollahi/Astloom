# Astloom operator env (repo root) — single source of truth
# Copy to `.env` and edit. `astloom init` / `install.sh` create `.env` when missing.
# NEVER commit `.env` — it is gitignored.
# Normative contract:
#   docs/13-technology-stack-and-platform-decisions/12-litellm-environment-configuration.md
# CLI loads this file automatically (process env still wins).

# =============================================================================
# Active scope (from astloom init)
# =============================================================================
ASTLOOM_TENANT_ID=acme
ASTLOOM_WORKSPACE_ID=eng
# ASTLOOM_PROJECT_ID=myapp
# Absolute software roots for sync (colon-separated). Prefer: astloom init --path …
# ASTLOOM_SOFTWARE_PATHS=/opt/MyApp

# --- Optional sync filters (comma-separated; or use astloom.sync.yaml) ---
# ASTLOOM_SYNC_EXCLUDE_DIRS=docs,tests,fixtures
# ASTLOOM_SYNC_INCLUDE_PATHS=backend/services,backend/packages
# ASTLOOM_SYNC_INCLUDE_EXTENSIONS=.py,.ts,.tsx

# --- Sync usage reports (one JSON per run; folder FIFO ≤5 GiB) ---
# Keep this path under an ignored tree (.astloom/… or logs/… or …/sync-usage/).
# ASTLOOM_SYNC_USAGE_LOG_DIR=.astloom/sync-usage
# ASTLOOM_SYNC_USAGE_LOG_DIR_MAX_BYTES=5368709120

# ASTLOOM_GRAPH_CLI_BACKEND
#   neo4j | postgres | memory — in-process graph CLI / sync backend hint.
# ASTLOOM_GRAPH_CLI_BACKEND=neo4j

# ASTLOOM_SYNC_CPU_PERCENT
#   Operator CPU budget for astloom sync (auto | 1-100).
#   When set to N, derives file workers ≈ N% of CPU cores, local-embed
#   concurrency, and pins Torch/OMP to 1 thread (avoids RAM blow-ups).
#   When docs and/or cloud embeds are enabled, workers are also capped at
#   ASTLOOM_LITELLM_RPM // 6 so many file threads do not starve the shared
#   LiteLLM RPM gate (symptom: high "active" workers, almost no files done).
#   Example: ASTLOOM_SYNC_CPU_PERCENT=25
# ASTLOOM_SYNC_CPU_PERCENT=auto
#
# ASTLOOM_SYNC_MAX_FILE_WORKERS
#   Advanced override: exact parallel file worker count.
#   When set to an integer, wins over ASTLOOM_SYNC_CPU_PERCENT (no LLM cap).
#   Default/auto → min(cpu, RPM) when LLM-cold; min(cpu, RPM//6) when hot.
# ASTLOOM_SYNC_MAX_FILE_WORKERS=auto

# Infra secrets for Compose live under:
#   backend/deployments/compose/.env.local
# (also gitignored; created by install.sh)

# =============================================================================
# Auth (server install auto-creates files under .astloom/; upgrade preserves)
# =============================================================================
# ASTLOOM_MCP_TOKEN_SECRET=          # JWT signing; file: .astloom/mcp-http.secret
# ASTLOOM_CONNECT_BOOTSTRAP_SECRET=  # connect bootstrap; file: .astloom/connect-bootstrap.secret
# Optional API key mint: bash install.sh --mint-api-key (ttl 0 = non-expiring)

# MCP Streamable HTTP — HTTPS by default (same certs as profile/graph under data-root/certs)
# ASTLOOM_MCP_HTTP_PUBLIC_URL=https://astloom.example.internal:32500
# ASTLOOM_PUBLIC_HOSTNAME=astloom.example.internal
# ASTLOOM_MCP_TLS=0                  # lab escape hatch: plain HTTP (clients need ALLOW_INSECURE_HTTP)
# ASTLOOM_MCP_TLS_CERTFILE=
# ASTLOOM_MCP_TLS_KEYFILE=

# Client TLS verify (coding-agent host) — see docs/08…/52-client-tls-trust-and-verify.md
# ASTLOOM_CONNECT_TLS_VERIFY=false   # default: encrypt, do not validate server cert
# ASTLOOM_CONNECT_CA_FILE=/path/to/ca.pem
# ASTLOOM_CONNECT_TLS_VERIFY=true    # require CA file above

# =============================================================================
# code-graph-service — listen port + structural store
# =============================================================================

# ASTLOOM_CODE_GRAPH_PORT — HTTP port (uvicorn). Port-profile default: 32140
ASTLOOM_CODE_GRAPH_PORT=32140

# ASTLOOM_CODE_GRAPH_STORE — neo4j | postgres (product default: neo4j)
ASTLOOM_CODE_GRAPH_STORE=neo4j

# PostgreSQL URL for pgvector + outbox (and structural data when store=postgres)
ASTLOOM_CODE_GRAPH_DATABASE_URL=postgresql://astloom:astloom@127.0.0.1:32232/astloom

# Neo4j (required when ASTLOOM_CODE_GRAPH_STORE=neo4j)
ASTLOOM_NEO4J_URI=bolt://127.0.0.1:32287
ASTLOOM_NEO4J_USER=neo4j
ASTLOOM_NEO4J_PASSWORD=replace-with-a-local-secret
ASTLOOM_NEO4J_DATABASE=neo4j
ASTLOOM_NEO4J_GDS_ENABLED=true
ASTLOOM_NEO4J_GDS_CONCURRENCY=4
# Opt in only when startup has network access; default Compose startup is offline-safe.
# ASTLOOM_NEO4J_PLUGINS=["apoc","graph-data-science"]
# ASTLOOM_NEO4J_IMAGE=neo4j:5.26-community

# Feature 49 — optional local LSP edit session (IDE-semantic; never dual-writes CODE_REL)
# ASTLOOM_LSP_EDIT_SESSION=1
# ASTLOOM_LSP_CMD_PYTHON=pyright-langserver --stdio
# ASTLOOM_LSP_CMD_TYPESCRIPT=typescript-language-server --stdio
# ASTLOOM_LSP_CMD_JAVASCRIPT=typescript-language-server --stdio
# ASTLOOM_LSP_CMD_GO=gopls serve
# ASTLOOM_LSP_CMD_RUST=rust-analyzer

# MCP gateway graph wiring (mcp-gateway-service)
# ASTLOOM_MCP_GRAPH_MODE=   # memory | postgres | neo4j; empty → auto
# ASTLOOM_MCP_GRAPH_SEED=false

# =============================================================================
# LiteLLM gateway
# ADR: docs/13-technology-stack-and-platform-decisions/09-litellm-llm-gateway.md
# Routing: docs/13-technology-stack-and-platform-decisions/10-model-routing-profiles-with-litellm.md
# =============================================================================

ASTLOOM_LITELLM_ENABLED=true
ASTLOOM_LITELLM_HOST=127.0.0.1
ASTLOOM_LITELLM_PORT=32400
# Optional Base URL override (empty → auto http://{HOST}:{PORT})
# ASTLOOM_LITELLM_API_BASE=http://127.0.0.1:32400
# Direct OpenRouter example:
# ASTLOOM_LITELLM_API_BASE=https://openrouter.ai/api/v1

# Key fallback order if empty: LITELLM_API_KEY → OPENROUTER_API_KEY → OPENAI_API_KEY
ASTLOOM_LITELLM_API_KEY=

ASTLOOM_LITELLM_DEFAULT_MODEL=ollama/qwen2.5-coder
# Verify: astloom llm test
ASTLOOM_LITELLM_TIMEOUT_SECONDS=180
ASTLOOM_LITELLM_NUM_RETRIES=3
ASTLOOM_LITELLM_RPM=30
ASTLOOM_LITELLM_DROP_PARAMS=true
ASTLOOM_LITELLM_DEBUG=false

# OpenRouter-style reasoning (required for some models e.g. openai/gpt-oss-*:free)
ASTLOOM_LITELLM_REASONING_ENABLED=false
# ASTLOOM_LITELLM_REASONING_EFFORT=

ASTLOOM_LITELLM_RISK_LEVEL=low
ASTLOOM_LITELLM_PROFILE_ID=env-default
ASTLOOM_LITELLM_DOCS_ENABLED=true
ASTLOOM_LITELLM_EMBEDDINGS_ENABLED=false

# Per-task model overrides (empty → DEFAULT_MODEL)
ASTLOOM_LITELLM_MODEL_DOCS=
ASTLOOM_LITELLM_MODEL_EMBED=
ASTLOOM_LITELLM_MODEL_JUDGE=
ASTLOOM_LITELLM_MODEL_CODEGEN=
# Comma/semicolon-separated fallbacks after primary fails
ASTLOOM_LITELLM_FALLBACK_MODELS=

# Native context compression before LiteLLM (doc 54). Opt-out: 0/false/off.
ASTLOOM_CONTEXT_COMPRESS=1
# ASTLOOM_CONTEXT_COMPRESS_MIN_CHARS=2000
# ASTLOOM_CONTEXT_COMPRESS_MAX_STRING=240
# ASTLOOM_CONTEXT_COMPRESS_MAX_LIST=24

# =============================================================================
# Local embeddings (BAAI/bge-large-en-v1.5, Stage-1 default)
# =============================================================================
ASTLOOM_EMBEDDING_PROVIDER=local_bge
ASTLOOM_EMBEDDING_LOCAL_ENABLED=true
ASTLOOM_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
ASTLOOM_EMBEDDING_CACHE_DIR=/opt/astloom-models
ASTLOOM_EMBEDDING_DIMS=1024
ASTLOOM_EMBEDDING_DEVICE=cpu
ASTLOOM_EMBEDDING_PRELOAD=false
# Prefer on-disk cache first. Set ALLOW_DOWNLOAD=0 (or HF_HUB_OFFLINE=1) so sync
# fails fast to stub embeddings when the model is not cached — avoids parallel
# workers hanging on a HuggingFace download.
# ASTLOOM_EMBEDDING_ALLOW_DOWNLOAD=1
# ASTLOOM_EMBEDDING_LOCAL_FILES_ONLY=0
# HF_HUB_OFFLINE=0
# TRANSFORMERS_OFFLINE=0

# =============================================================================
# Optional Stage-2 ANN (Turbovec) — default OFF
# Durable embeddings stay on PostgreSQL + pgvector (Stage-1). Turbovec is an
# optional in-process replica for allowlist rerank. Docs:
#   docs/13-technology-stack-and-platform-decisions/11-turbovec-for-rag.md
#   docs/13-technology-stack-and-platform-decisions/08-turbovec-ann-acceleration-integration.md
# Prerequisites: pip install '.[turbovec]'  (or astloom[turbovec])
# Before enabling in production: python -m vector_index.promotion_gate
# =============================================================================
ASTLOOM_RAG_ANN_ACCELERATOR=off
# ASTLOOM_RAG_ANN_ACCELERATOR=turbovec
# ASTLOOM_TURBOVEC_BIT_WIDTH=4
# ASTLOOM_TURBOVEC_SNAPSHOT_URI=/var/lib/astloom/ann-replica.tvim
# ASTLOOM_TURBOVEC_SYNC_MODE=sync_on_write
# ASTLOOM_TURBOVEC_ID_MAP_TABLE=
# ASTLOOM_TURBOVEC_ID_MAP_DATABASE_URL=

# =============================================================================
# Optional provider credentials (set only what you use)
# Discovery: PYTHONPATH=backend/packages python -m llm_gateway providers
# =============================================================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=
# OLLAMA_API_BASE=http://127.0.0.1:11434
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# LITELLM_API_BASE=   # alias when ASTLOOM_LITELLM_API_BASE empty
# LITELLM_API_KEY=    # alias when ASTLOOM_LITELLM_API_KEY empty

# Automated follow-up Task retention (sync + quality). Days to keep terminal Tasks
# before hard-delete. Default 30. Set 0 to never purge.
# ASTLOOM_FOLLOWUP_TASK_RETENTION_DAYS=30
