# Astloom Git Ignore
#
# Keep this file tracked. Do not add /.gitignore here — remote clones would lose
# ignore rules (secrets, archives, runtime data) and git-sync could push them.

# Local archives / offline packs — NEVER commit, stage, or push to GitHub/remotes.
# Any tree named archives/Archive/archive (any case, root or nested) stays local-only.
archives/
Archives/
Archive/
archive/
**/archives/**
**/Archives/**
**/Archive/**
**/archive/**

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
.smoke-temp/
*.egg-info/

# =============================================================================
# Astloom operator runtime (local data / logs / secrets — never commit)
# Default state: .astloom/  (projects, sync-progress, sync-usage, mcp fragment,
# optional sync.yaml override, install-state, probes).
# If you relocate ASTLOOM_SYNC_USAGE_LOG_DIR, keep it under .astloom/, logs/,
# or a folder named sync-usage/ so these rules still apply.
# =============================================================================
.astloom/

# HTTPS / TLS auto-certs (ensure_tls_material; never commit private CA/leaf)
# Broader *.pem / *.key rules above also apply; these pin the data-root layout.
**/certs/ca.pem
**/certs/ca.key
**/certs/server.pem
**/certs/server.key
**/.astloom-certs.json
**/certs/.astloom-certs.json
# Sibling durable data root beside install (Postgres/Neo4j/usage/certs)
Astloom-data/
**/Astloom-data/
# Live HTTPS probe scratch if created under the tree
**/astloom-live-https-qa/
# Local agent scratch (SDD ledgers, PR drafts, pytest dumps — not product SoT)
.superpowers/

# Sync usage reports (default .astloom/sync-usage/; also if relocated)
**/sync-usage/
sync-usage.jsonl
**/sync-usage.jsonl
*.sync-usage.jsonl
# MCP token usage JSONL (default .astloom/mcp-usage/)
**/mcp-usage/

# Sync filter copy (operator-owned; template stays tracked)
astloom.sync.yaml
astloom.sync.yml
!astloom.sync.yaml.example
!astloom.sync.yml.example

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
coverage/
.npm/
.pnpm-store/
.yarn/

# Environment and secrets (never commit real values)
.env
.env.local
**/.env
**/.env.local
.env.*
!**/.env.example
!.env.example
!**/*.example.env
*.pem
*.key
*.crt
*.p12
*.pfx
*.token
*.secret
secrets/
.local-secrets/
**/credentials.json
**/credentials.local.*

# git-sync (local-only tool + PAT + first-push msg + change notes — never commit)
scripts/git-sync.sh
**/git-sync.sh
scripts/.git-sync-first-push.msg
**/.git-sync-first-push.msg
scripts/.git-sync-changes/
**/.git-sync-changes/
**/.git-sync.local.env
**/.git-sync.local.env.*
**/git-sync.local.env
**/git-sync.local.env.*
**/.git-sync.credentials
**/git-sync.credentials
!**/git-sync.local.env.example

# Logs and runtime output
*.log
logs/
runtime/
tmp/
tmp/**
/tmp/
temp/
.cache/
.DS_Store
Thumbs.db
.pip-show.txt
.pip-*.txt
# Agent/session scratch files (never commit)
.tmp-*
.tmp_*
**/_tmp_*
scripts/_tmp_*
pytest-audit.txt
cs_pytest.txt

