ASTLOOM_MEMORY_SERVICE_DATABASE_URL=postgresql://astloom:change-me@postgres:5432/astloom
ASTLOOM_MEMORY_PROFILE_ID=default-memory-profile
ASTLOOM_MEMORY_PROFILE_VERSION=1
ASTLOOM_MEMORY_CONTEXT_TOKEN_BUDGET=1200
# Optional Stage-2 ANN (default off). Prefer repo-root .env for operators
# (install.sh / astloom loads root .env). Requires: pip install '.[turbovec]'
# ASTLOOM_RAG_ANN_ACCELERATOR=turbovec
# ASTLOOM_TURBOVEC_BIT_WIDTH=4
# ASTLOOM_TURBOVEC_SNAPSHOT_URI=/var/lib/astloom/memory-ann.tvim
# ASTLOOM_TURBOVEC_SYNC_MODE=sync_on_write
# ASTLOOM_EMBEDDING_DIMS=1024
# Guide: docs/13-technology-stack-and-platform-decisions/11-turbovec-for-rag.md
