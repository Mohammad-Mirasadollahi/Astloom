# Sibling of the install root by default (e.g. /opt/Astloom → /opt/Astloom-data).
# Install / astloom service start writes the resolved path; override if needed.
ASTLOOM_DATA_ROOT=/opt/Astloom-data
ASTLOOM_POSTGRES_DATABASE=astloom
ASTLOOM_POSTGRES_USER=astloom
ASTLOOM_POSTGRES_PASSWORD=replace-with-a-local-secret
ASTLOOM_POSTGRES_PORT=32232
ASTLOOM_NEO4J_USER=neo4j
ASTLOOM_NEO4J_PASSWORD=replace-with-a-local-secret
ASTLOOM_NEO4J_BOLT_PORT=32287
ASTLOOM_NEO4J_HTTP_PORT=32474
# Plugins are enabled in compose.yaml (APOC + Graph Data Science Community).
# App-side GDS usage (optional degree ranking) — defaults ON, 4-core Community cap:
# ASTLOOM_NEO4J_GDS_ENABLED=true
# ASTLOOM_NEO4J_GDS_CONCURRENCY=4
#
# Optional Stage-2 ANN (Turbovec) — set in repo-root .env (not required for Compose infra).
# Default off. See .env.example and docs/13-technology-stack-and-platform-decisions/11-turbovec-for-rag.md
# ASTLOOM_RAG_ANN_ACCELERATOR=off
